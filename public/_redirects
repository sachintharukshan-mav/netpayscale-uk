/year/                                   /    301
/month                                   /    301
/month/                                  /    301
/mo                                      /    301
/mo/                                     /    301
/yr                                      /    301
/yr/                                     /    301

# Resolve Schema SearchAction template URL crawler hits
/calculator/{search_term_string}         /    301
/calculator/{search_term_string}/        /    301
/calculator/%7Bsearch_term_string%7D     /    301
/calculator/%7Bsearch_term_string%7D/    /    301

